{
  "cosmos-installer": {},
  "minVersion": "0.9.0",
  "services": {
    "{ServiceName}": {
      "image": "marcusholtz/party-line-pager-full:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "environment": [
        "PLP_PROVIDERS=tor,web",
        "PLP_AUTO_START=0",
        "PLP_HEADLESS=0",
        "PLP_WEB_BASE_URL=https://p2p.mirotalk.com",
        "TTYD_CREDENTIAL=",
        "TELEGRAM_TOKEN=",
        "DISCORD_TOKEN=",
        "MATRIX_HOMESERVER=",
        "MATRIX_USER=",
        "MATRIX_PASSWORD=",
        "MATRIX_STORE_PATH=/var/lib/party-line-pager/matrix",
        "IRC_SERVER=",
        "IRC_PORT=6697",
        "IRC_NICK=party-line-pager",
        "IRC_TLS=true",
        "IRC_CHANNEL=",
        "IRC_ACCOUNT=",
        "IRC_PASSWORD=",
        "XMPP_JID=",
        "XMPP_PASSWORD=",
        "MASTODON_INSTANCE=",
        "MASTODON_TOKEN=",
        "MATTERMOST_URL=",
        "MATTERMOST_TOKEN=",
        "SIGNAL_NUMBER=",
        "EMAIL_SMTP_HOST=",
        "EMAIL_SMTP_PORT=587",
        "EMAIL_SMTP_USER=",
        "EMAIL_SMTP_PASSWORD=",
        "EMAIL_IMAP_HOST=",
        "EMAIL_FROM="
      ],
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-icon": "https://raw.githubusercontent.com/MarcusHoltz/marcusholtz.github.io/refs/heads/main/assets/img/posts/party-line-pager--tor-i2p-rns-call-pager.png"
      },
      "volumes": [
        {
          "source": "{ServiceName}-config",
          "target": "/config",
          "type": "volume"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Expose {ServiceName} web terminal",
          "useHost": true,
          "target": "http://{ServiceName}:7681",
          "mode": "SERVAPP",
          "Timeout": 14400000,
          "ThrottlePerMinute": 12000,
          "BlockCommonBots": true,
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
